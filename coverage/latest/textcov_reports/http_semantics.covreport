 2421|  1.63M|            // were false, for example, then 'a*' would also need to be false
 2422|  1.63M|            // since it too can match the empty string.
 2423|  1.63M|            utf8: true,
 2424|  1.63M|            explicit_captures_len: 0,
 2425|  1.63M|            static_explicit_captures_len: Some(0),
 2426|  1.63M|            literal: false,
 2427|  1.63M|            alternation_literal: false,

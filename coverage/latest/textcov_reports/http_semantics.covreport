 2280|  58.4k|                Some(new_end) => new_end,
 2281|       |                None => {
 2282|      0|                    return Err(GroupInfoError::too_many_groups(
 2283|      0|                        pid, group_len,
 2284|      0|                    ))
 2285|       |                }
 2286|       |            };
 2287|  58.4k|            *end = SmallIndex::new(new_end).map_err(|_| {

   53|  4.20k|                .start_kind(aho_corasick::StartKind::Both)
   54|  4.20k|                // We try to handle all of the prefilter cases in the super
   55|  4.20k|                // module, and only use Aho-Corasick for the actual automaton.
   56|  4.20k|                // The aho-corasick crate does have some extra prefilters,
   57|  4.20k|                // namely, looking for rare bytes to feed to memchr{,2,3}
   58|  4.20k|                // instead of just the first byte. If we end up wanting
   59|  4.20k|                // those---and they are somewhat tricky to implement---then
   60|  4.20k|                // we could port them to this crate.
   61|  4.20k|                //
   62|  4.20k|                // The main reason for doing things this way is so we have a
   63|  4.20k|                // complete and easy to understand picture of which prefilters
   64|  4.20k|                // are available and how they work. Otherwise it seems too
   65|  4.20k|                // easy to get into a situation where we have a prefilter
   66|  4.20k|                // layered on top of prefilter, and that might have unintended
   67|  4.20k|                // consequences.
   68|  4.20k|                .prefilter(false)
   69|  4.20k|                .build(needles);
   70|  4.20k|            let ac = match result {
   71|  4.20k|                Ok(ac) => ac,
   72|      0|                Err(_err) => {
   73|       |                    debug!("aho-corasick prefilter failed to build: {_err}");
   74|      0|                    return None;
   75|       |                }
   76|       |            };
   77|  4.20k|            Some(AhoCorasick { ac })
   78|       |        }
   79|  4.20k|    }

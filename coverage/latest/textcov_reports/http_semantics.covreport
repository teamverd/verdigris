 3554|  71.8k|        let (mut asts, mut hirs) = (vec![], vec![]);
 3555|  71.8k|        for (pid, p) in patterns.iter().with_pattern_ids() {
 3556|  71.8k|            let ast = self
 3557|  71.8k|                .ast
 3558|  71.8k|                .build()
 3559|  71.8k|                .parse(p.as_ref())
 3560|  71.8k|                .map_err(|err| BuildError::ast(pid, err))?;
 3561|  58.7k|            asts.push(ast);
 3562|       |        }
 3563|  58.7k|        for ((pid, p), ast) in
 3564|  58.7k|            patterns.iter().with_pattern_ids().zip(asts.iter())
 3565|       |        {
 3566|  58.7k|            let hir = self
 3567|  58.7k|                .hir
 3568|  58.7k|                .build()
 3569|  58.7k|                .translate(p.as_ref(), ast)
 3570|  58.7k|                .map_err(|err| BuildError::hir(pid, err))?;
 3571|  58.5k|            hirs.push(hir);

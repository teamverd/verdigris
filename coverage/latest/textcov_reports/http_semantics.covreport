 3534|       |        use crate::util::primitives::IteratorIndexExt;
 3535|       |        log! {
 3536|       |            debug!("building meta regex with {} patterns:", patterns.len());
 3537|       |            for (pid, p) in patterns.iter().with_pattern_ids() {
 3538|       |                let p = p.as_ref();

 2503|   404k|    fn repetition(rep: &Repetition) -> Properties {
 2504|   404k|        let p = rep.sub.properties();
 2505|   404k|        let minimum_len = p.minimum_len().map(|child_min| {
 2506|       |            let rep_min = usize::try_from(rep.min).unwrap_or(usize::MAX);
 2507|       |            child_min.saturating_mul(rep_min)
 2508|       |        });
 2509|   404k|        let maximum_len = rep.max.and_then(|rep_max| {
 2510|       |            let rep_max = usize::try_from(rep_max).ok()?;
 2511|       |            let child_max = p.maximum_len()?;
 2512|       |            child_max.checked_mul(rep_max)
 2513|       |        });
 2514|       |
 2515|   404k|        let mut inner = PropertiesI {
 2516|   404k|            minimum_len,
 2517|   404k|            maximum_len,
 2518|   404k|            look_set: p.look_set(),
 2519|   404k|            look_set_prefix: LookSet::empty(),
 2520|   404k|            look_set_suffix: LookSet::empty(),
 2521|   404k|            look_set_prefix_any: p.look_set_prefix_any(),
 2522|   404k|            look_set_suffix_any: p.look_set_suffix_any(),
 2523|   404k|            utf8: p.is_utf8(),
 2524|   404k|            explicit_captures_len: p.explicit_captures_len(),
 2525|   404k|            static_explicit_captures_len: p.static_explicit_captures_len(),
 2526|   404k|            literal: false,
 2527|   404k|            alternation_literal: false,
 2528|   404k|        };
 2529|       |        // If the repetition operator can match the empty string, then its
 2530|       |        // lookset prefix and suffixes themselves remain empty since they are
 2531|       |        // no longer required to match.
 2532|   404k|        if rep.min > 0 {
 2533|  58.1k|            inner.look_set_prefix = p.look_set_prefix();
 2534|  58.1k|            inner.look_set_suffix = p.look_set_suffix();
 2535|   345k|        }
 2536|       |        // If the static captures len of the sub-expression is not known or
 2537|       |        // is greater than zero, then it automatically propagates to the
 2538|       |        // repetition, regardless of the repetition. Otherwise, it might
 2539|       |        // change, but only when the repetition can match 0 times.
 2540|   404k|        if rep.min == 0
 2541|   345k|            && inner.static_explicit_captures_len.map_or(false, |len| len > 0)
 2542|       |        {

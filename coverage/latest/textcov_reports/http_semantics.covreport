 2547|     40|            if rep.max == Some(0) {
 2548|      0|                inner.static_explicit_captures_len = Some(0);
 2549|     40|            } else {
 2550|     40|                inner.static_explicit_captures_len = None;
 2551|     40|            }
 2552|   404k|        }
 2553|   404k|        Properties(Box::new(inner))
 2554|   404k|    }

 3544|       |                    .take(1000)
 3545|       |                    .last()
 3546|       |                    .unwrap_or(0);
 3547|       |                if maxoff < p.len() {
 3548|       |                    debug!("{pid:?}: {}[... snip ...]", &p[..maxoff]);
 3549|       |                } else {
 3550|       |                    debug!("{pid:?}: {p}");
 3551|       |                }
 3552|       |            }

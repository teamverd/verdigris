   12|      3|pub fn cautious<Element>(hint: Option<usize>) -> usize {
   13|       |    const MAX_PREALLOC_BYTES: usize = 1024 * 1024;
   14|       |
   15|      3|    if mem::size_of::<Element>() == 0 {
   16|      0|        0
   17|       |    } else {
   18|      3|        cmp::min(
   19|      3|            hint.unwrap_or(0),
   20|      3|            MAX_PREALLOC_BYTES / mem::size_of::<Element>(),
   21|       |        )
   22|       |    }
   23|      3|}


  688|       |    impl<'de> Deserialize<'de> for Entry {
  689|       |        fn deserialize<D: serde::Deserializer<'de>>(d: D) -> Result<Self, D::Error> {
  690|       |            d.deserialize_any(EntryVisitor).map(Entry)
  691|       |        }
  692|       |    }
  693|       |
  694|       |    struct EntryVisitor;
  695|       |
  696|       |    impl<'de> serde::de::Visitor<'de> for EntryVisitor {
  697|       |        type Value = UpstreamConfig;
  698|       |        fn expecting(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result {
  699|       |            f.write_str(EXPECTING)
  700|       |        }
  701|       |        fn visit_str<E: serde::de::Error>(self, v: &str) -> Result<UpstreamConfig, E> {
  702|       |            Ok(one(vec![UpstreamServer::new(v.to_owned())]))
  703|       |        }
  704|       |        fn visit_seq<A: serde::de::SeqAccess<'de>>(self, s: A) -> Result<UpstreamConfig, A::Error> {
  705|       |            Vec::deserialize(SeqAccessDeserializer::new(s)).map(one)
  706|       |        }
  707|       |        fn visit_map<A: MapAccess<'de>>(self, mut m: A) -> Result<UpstreamConfig, A::Error> {
  708|       |            // `{ url = "…" }` is a one-server entry — `url`, `weight` and
  709|       |            // `backup` are not UpstreamConfig fields, so the first key
  710|       |            // disambiguates. The full table is deserialized directly so
  711|       |            // its own errors (unknown fields, `did you mean`) reach the user.
  712|       |            let first = m.next_key::<String>()?;
  713|       |            let server = matches!(first.as_deref(), Some("url" | "weight" | "backup"));
  714|       |            let map = MapAccessDeserializer::new(Prepend { first, rest: m });
  715|       |            if server {
  716|       |                UpstreamServer::deserialize(map).map(|s| one(vec![s]))
  717|       |            } else {
  718|       |                UpstreamConfig::deserialize(map)
  719|       |            }
  720|       |        }
  721|       |        fn visit_bool<E: serde::de::Error>(self, _: bool) -> Result<UpstreamConfig, E> {
  722|       |            Err(E::custom(EXPECTING))
  723|       |        }
  724|       |        fn visit_i64<E: serde::de::Error>(self, _: i64) -> Result<UpstreamConfig, E> {
  725|       |            Err(E::custom(EXPECTING))
  726|       |        }
  727|       |        fn visit_u64<E: serde::de::Error>(self, _: u64) -> Result<UpstreamConfig, E> {
  728|       |            Err(E::custom(EXPECTING))
  729|       |        }
  730|       |        fn visit_f64<E: serde::de::Error>(self, _: f64) -> Result<UpstreamConfig, E> {
  731|       |            Err(E::custom(EXPECTING))
  732|       |        }
  733|       |    }
  734|       |
  735|       |    struct MapVisitor;
  736|       |
  737|       |    impl<'de> serde::de::Visitor<'de> for MapVisitor {
  738|       |        type Value = BTreeMap<String, UpstreamConfig>;
  739|       |        fn expecting(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result {
  740|       |            f.write_str("a table of upstream clusters")
  741|       |        }
  742|       |        fn visit_map<A: MapAccess<'de>>(self, mut m: A) -> Result<Self::Value, A::Error> {
  743|       |            let mut out = BTreeMap::new();
  744|       |            while let Some((name, Entry(cfg))) = m.next_entry::<String, Entry>()? {
  745|       |                out.insert(name, cfg);
  746|       |            }
  747|       |            Ok(out)
  748|       |        }
  749|       |    }

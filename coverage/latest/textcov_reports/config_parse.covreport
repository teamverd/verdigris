   48|  5.49k|    pub fn into_vec(self) -> Vec<Token> {
   49|  5.49k|        let len = self.stream.len();
   50|       |        // The 2/7 ratio was determined by looking packaged manifests under a representative set of
   51|       |        // packages determined by dependencies of several large, popular projects.
   52|       |        //
   53|       |        // Divide before multiplying to avoid overflowing for very large inputs.
   54|  5.49k|        let estimate = (len / 7) * 2;
   55|  5.49k|        let addressable_limit = isize::MAX as usize / size_of::<Token>();
   56|  5.49k|        let capacity = estimate.min(addressable_limit);
   57|  5.49k|        let mut vec = Vec::with_capacity(capacity);
   58|  5.49k|        vec.extend(self);
   59|  5.49k|        vec
   60|  5.49k|    }
